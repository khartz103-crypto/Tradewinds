# TradeWind AI — Environment Variables
# Copy this file to .env and adjust for your environment:
#   cp .env.example .env
# Docker Compose reads .env automatically and passes the values to services.

# ──────────────────────────── Database ────────────────────────────
# Async SQLAlchemy DSN for PostgreSQL. In docker-compose this points at the
# `db` service (user/password/db are set in docker-compose.yml).
DATABASE_URL=postgresql+asyncpg://tradewind:tradewind@db:5432/tradewind

# ───────────────────────────── Redis ──────────────────────────────
# Redis connection URL. Used for caching / message broker.
REDIS_URL=redis://redis:6379/0

# ───────────────────────────── Backend ────────────────────────────
# Comma-separated list of origins allowed to call the API (CORS).
CORS_ORIGINS=http://localhost:3000
# Enable verbose debug logging (true/false).
DEBUG=false

# ────────────────────────────── Seed ──────────────────────────────
# Credentials for the admin user created by `python -m app.seed`
# (runs automatically on backend startup in docker-compose).
SEED_ADMIN_EMAIL=admin@tradewind.ai
# ⚠ Change this before any deployment that is not a local sandbox.
SEED_ADMIN_PASSWORD=admin

# ─────────────────────── Alpaca (paper by default) ────────────────
# Get paper-trading API keys at https://app.alpaca.markets (free account).
# Leave empty to run the app without live market data (UI-only mode).
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Paper-trading API base URL (use https://api.alpaca.markets only if you
# explicitly enable live trading — TradeWind AI defaults to paper).
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Market data API base URL.
ALPACA_DATA_URL=https://data.alpaca.markets

# ──────────────────────── Market Data Cache ───────────────────────
# How long (minutes) fetched bars/snapshots stay valid in the DB cache.
MARKET_DATA_CACHE_TTL_MINUTES=15

# ────────────────────────────── JWT ───────────────────────────────
# HS256 signing secret for auth tokens.
# ⚠ Change this before any deployment that is not a local sandbox.
JWT_SECRET=change-me-in-production
# Token lifetime in hours.
JWT_EXPIRY_HOURS=24

# ───────────────────────────── Frontend ───────────────────────────
# Base URL the browser uses to reach the FastAPI backend. Must be
# reachable from the browser, not from inside Docker (hence localhost).
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
