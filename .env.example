# TradeWind AI — Environment Variables
# Copy this file to .env and adjust for your environment.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://tradewind:tradewind@db:5432/tradewind

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Backend ---
CORS_ORIGINS=http://localhost:3000
DEBUG=false

# --- Seed ---
SEED_ADMIN_EMAIL=admin@tradewind.ai
SEED_ADMIN_PASSWORD=admin

# --- Alpaca (paper trading by default) ---
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# --- Market Data Cache ---
MARKET_DATA_CACHE_TTL_MINUTES=15

# --- Frontend ---
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
